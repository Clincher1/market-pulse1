# Скопируйте этот файл в .env и подставьте свои значения,
# либо задайте эти переменные в настройках StackBlitz / Vercel.
# Если переменные не заданы, приложение использует значения
# по умолчанию из src/lib/supabase.ts.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key

# Публичное имя Telegram-бота поддержки без символа @.
# Ссылка в подвале и начальном HTML появляется только при валидном имени.
# VITE_TELEGRAM_SUPPORT_BOT_USERNAME=MarketPulseSupportBot
# TELEGRAM_SUPPORT_BOT_USERNAME=MarketPulseSupportBot

# Секреты бота — ТОЛЬКО в защищённых переменных среды Vercel, не в VITE_*:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_SUPPORT_ADMIN_ID=
# TELEGRAM_WEBHOOK_SECRET=

# Ходить в базу через свой домен (прокси /sb в server/origin.mjs).
# Включите это на хостинге в России: браузер посетителя тогда не обращается
# к *.supabase.co, который пропускают не все операторы.
# VITE_SUPABASE_PROXY=/sb
