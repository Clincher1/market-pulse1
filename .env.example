# Скопируйте этот файл в .env и подставьте свои значения,
# либо задайте эти переменные в настройках StackBlitz / Vercel.
# Если переменные не заданы, приложение использует значения
# по умолчанию из src/lib/supabase.ts.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key
