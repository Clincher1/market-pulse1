{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/telegram/channel/daily",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/brief-image.js": {
      "includeFiles": "api/assets/**",
      "maxDuration": 30
    },
    "api/russia-insights.js": {
      "includeFiles": "certs/moex-ca-bundle.pem",
      "maxDuration": 30
    },
    "api/russia-history.js": {
      "includeFiles": "certs/moex-ca-bundle.pem",
      "maxDuration": 30
    },
    "api/telegram-support.js": {
      "maxDuration": 30
    },
    "api/telegram-support-setup.js": {
      "maxDuration": 30
    },
    "api/telegram/channel/trigger.js": {
      "maxDuration": 30
    },
    "api/telegram/channel/daily.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/passport",
      "destination": "/passport.html"
    },
    {
      "source": "/russia",
      "destination": "/russia.html"
    },
    {
      "source": "/world",
      "destination": "/world.html"
    },
    {
      "source": "/brief",
      "destination": "/brief.html"
    },
    {
      "source": "/news",
      "destination": "/news.html"
    },
    {
      "source": "/guide",
      "destination": "/guide.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/status",
      "destination": "/status.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'sha256-mPRvFtvocZwUS+bJkgPQTLUVPMssKjqDe7cN2piY4qc='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; frame-src 'none'; media-src 'none'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/memory/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "trailingSlash": false
}
